# Release-time secrets for scripts/build_release.sh — copy to .env.build
# (gitignored) and fill in. Values can be copied from tide_share's .env.build.

# Apple notarization (app-specific password from appleid.apple.com).
APPLE_ID=you@example.com
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Codesigning identity. Leave empty to auto-detect the first
# "Developer ID Application" identity in the keychain.
APPLE_SIGNING_IDENTITY=

# NOTE: a tide_share-style .env.build works unchanged — build_release.sh aliases
#   APPLE_PASSWORD <- APPLE_APP_PASSWORD
#   APPLE_TEAM_ID  <- APPLE_NOTARY_TEAM_ID
# so you can copy that file here as-is instead of retyping the values.
