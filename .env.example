# MusicSync — local configuration. Copy to .env (gitignored) and adjust.
#
# MusicSync is a LAN-only app: it talks to LP10 speakers over plain HTTP on the
# local network (http://<ip>/httpapi.asp). There is no cloud backend and no
# account server, so none of these values are credentials — they only tune
# discovery/polling behaviour and point the release tooling at R2.

# Rust log level for the Tauri backend (error | warn | info | debug | trace).
MUSIC_SYNC_LOG=info

# Subnet used by the fallback sweep scan when mDNS/SSDP finds nothing.
# Auto-detected from the active interface when unset.
# MUSIC_SYNC_SUBNET=192.168.1.0/24

# Device poller cadence (ms) — how often getStatusEx/getPlayerStatus are polled.
# MUSIC_SYNC_POLL_MS=3000

# Per-request HTTP timeout (ms) for httpapi.asp calls. Keep it short: an
# offline speaker must not stall the whole polling cycle.
# MUSIC_SYNC_HTTP_TIMEOUT_MS=2000

# --- Release hosting (scripts/build_release.sh, scripts/publish_windows.sh) ---
# Public base URL of the music_sync/ prefix in the shared house `storage` R2
# bucket. Installers live under /mac /windows; the updater manifest is
# {MUSIC_SYNC_BUCKET}/latest.json (also baked into tauri.conf.json
# plugins.updater.endpoints).
MUSIC_SYNC_BUCKET=https://pub-7b3e5bbd605d43adbeb4601a962d84bd.r2.dev/music_sync
# Optional overrides (script defaults shown):
# MUSIC_SYNC_R2_BUCKET=storage/music_sync
# MUSIC_SYNC_R2_ENDPOINT=https://d76960bd74940e6213de6aa16f3e04fd.r2.cloudflarestorage.com
# MUSIC_SYNC_R2_PROFILE=r2
