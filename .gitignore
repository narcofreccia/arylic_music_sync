# ─────────────────────────── Secrets — NEVER commit ───────────────────────────
.env
.env.*
!.env.example
!.env.build.example
# Signing / updater / TLS keys
*.key
*.pem
*.p12
*.keystore
.tauri/

# ───────────────────────────── Dependencies ──────────────────────────────────
node_modules/
.pnpm-store/

# ───────────────────────────── Build output ──────────────────────────────────
build/
dist/
.svelte-kit/
# Rust / Tauri (gen/ is generated by Tauri)
src-tauri/target/
src-tauri/gen/
# NOTE: Cargo.lock and pnpm-lock.yaml are intentionally committed (not ignored).

# ───────────────────────── Caches & tooling output ───────────────────────────
.vite/
coverage/
*.tsbuildinfo
vite.config.*.timestamp-*
**/*.rs.bk

# ───────────────────────────── Local data ────────────────────────────────────
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# ─────────────────────────────── Logs ────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ────────────────────────────── OS / editor ──────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# LibreWireless Luci client cert — PUBLIC (from open-source LSCommunicator SDK), safe to commit
!src-tauri/src/luci/assets/librewireless_client_cert.pem
!src-tauri/src/luci/assets/librewireless_client_key.pem
